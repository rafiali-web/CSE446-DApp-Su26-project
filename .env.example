# ==============================================================================
# BountyPulse — environment template
# ------------------------------------------------------------------------------
# Copy to `.env` (setup.sh does this automatically) and fill in real values.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. This template contains
# placeholders only — no real credential belongs in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Pinata / IPFS
# ------------------------------------------------------------------------------
# Create a free key at https://app.pinata.cloud/developers/api-keys.
#
# Pinata accepts TWO authentication styles. Supply EITHER:
#
#   (a) PREFERRED — a single JWT, sent as `Authorization: Bearer <jwt>`.
#       This is the modern scheme, it is scopeable, and it is one secret
#       instead of two.
#
#   (b) LEGACY — the API key / secret pair, sent as the `pinata_api_key` and
#       `pinata_secret_api_key` headers. Supported for accounts still issuing
#       these. The DApp falls back to this pair only when no JWT is present.
#
# SECURITY — READ THIS:
# In this local demo the DApp calls the Pinata REST API directly from the
# browser, which means whichever credential you use is visible to anyone using
# the page. That is acceptable for a local, single-developer demo on a
# throwaway key and is UNACCEPTABLE in production. In production, front the
# upload with your own backend: browser -> your API (authenticated,
# rate-limited) -> Pinata, so the credential never leaves your server.
# See README > Security Notes.
#
# The frontend never reads this file — a static page cannot read .env. Paste the
# credential into the DApp's "IPFS / Pinata" panel; it is kept in localStorage
# for that browser only.
#
# NEVER commit real values. `.env` is git-ignored; this template holds
# placeholders only.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# Public read gateway used to render pinned avatars, briefs and work files.
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ------------------------------------------------------------------------------
# Local EVM chain (Anvil)
# ------------------------------------------------------------------------------
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# ------------------------------------------------------------------------------
# Deployer key
# ------------------------------------------------------------------------------
# The value below is Anvil's FIRST well-known development account. It is printed
# by anvil on every start, is published in Foundry's documentation, and is
# identical on every machine on earth. It is a PLACEHOLDER for local use only.
#
#   Address: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
#
# It holds no value on any real network. NEVER put a mainnet/testnet key with
# real funds in this file. The account that deploys the contract becomes the
# Arbiter, so import this key into MetaMask to act as the platform overseer.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# Optional: arbiter profile written at deploy time by script/Deploy.s.sol
# ------------------------------------------------------------------------------
ARBITER_NAME=BountyPulse Arbiter
# Any valid CID works here; this is the canonical IPFS "hello world" object.
ARBITER_AVATAR_CID=QmYwAPJzv5CZsnA625s3Xf2nemtYgPpHdWEz79ojWnPbdG
